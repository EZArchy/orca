{
  "manifestVersion": 2,
  "id": "material-icons",
  "publisher": "brennanb2025",
  "name": "Material Icon Theme",
  "version": "1.0.0",
  "execution": "data",
  "description": "Colorful file icons from Material Icon Theme for about 470 common file types and names, with a variant for light themes.",
  "license": "MIT",
  "repository": "https://github.com/brennanb2025/orca-plugins/tree/main/plugins/material-icons",
  "engines": {
    "orca": ">=1.4.244"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "material",
        "title": "Material Icons",
        "path": "icons/theme.json"
      },
      {
        "id": "material-light",
        "title": "Material Icons (Light)",
        "path": "icons/theme-light.json"
      }
    ]
  },
  "capabilities": []
}
